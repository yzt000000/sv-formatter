{
  // Route "Format Document" / "Format Selection" to this extension by default.
  "[systemverilog]": {
    "editor.defaultFormatter": "yzt000000.sv-formatter"
  },
  "[verilog]": {
    "editor.defaultFormatter": "yzt000000.sv-formatter"
  },

  // This workspace is the formatter's own corpus; force HD files onto the
  // language ids the formatter registers so the test is unambiguous.
  "files.associations": {
    "*.v": "systemverilog",
    "*.vh": "systemverilog",
    "*.sv": "systemverilog",
    "*.svh": "systemverilog"
  },

  // Off for testing: press Shift+Alt+F manually, so nothing reformats behind you.
  "editor.formatOnSave": false,
  "systemverilogFormatter.trace.server": "off",
  "systemverilogFormatter.instanceLayout": "auto",
  "systemverilogFormatter.compactInstanceMaxPorts": 4,
  "systemverilogFormatter.indentSize": 4
}
